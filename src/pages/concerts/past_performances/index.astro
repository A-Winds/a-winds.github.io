---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PastPerformanceItem, {
  type Piece,
  type Performance,
} from "../../../components/PastPerformanceItem.astro";
import { microcmsClient } from "../../../lib/microcms";

type ProgramItem = {
  piece?: {
    id: string;
  };
};

type Concert = Performance & {
  programItems?: ProgramItem[];
};

const [pieces, concerts] = await Promise.all([
  microcmsClient.getAllContents<Piece>({
    endpoint: "kyoku",
    queries: {
      depth: 1,
    },
  }),

  microcmsClient.getAllContents<Concert>({
    endpoint: "ensokai",
    queries: {
      fields: "title,slug,date,competition,programItems",
      depth: 1,
    },
  }),
]);

const performancesByPiece = new Map<string, Performance[]>();

for (const concert of concerts) {
  const pieceIds = new Set(
    (concert.programItems ?? [])
      .map((item) => item.piece?.id)
      .filter((id): id is string => Boolean(id))
  );

  for (const pieceId of pieceIds) {
    const performances = performancesByPiece.get(pieceId) ?? [];

    performances.push({
      title: concert.title,
      slug: concert.slug,
      date: concert.date,
      competition: concert.competition,
    });

    performancesByPiece.set(pieceId, performances);
  }
}

for (const performances of performancesByPiece.values()) {
  performances.sort(
    (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime()
  );
}

const collator = new Intl.Collator("ja", {
  sensitivity: "base",
  numeric: true,
});

const getFirstPerformanceDate = (pieceId: string) => {
  const performances = performancesByPiece.get(pieceId);
  if (!performances?.length) return 0;

  return Math.min(
    ...performances.map((performance) => new Date(performance.date).getTime())
  );
};

const sortedPieces = pieces
  .filter((piece) => (performancesByPiece.get(piece.id)?.length ?? 0) > 0)
  .sort((a, b) => {
    if (a.commissioned !== b.commissioned) {
      return Number(Boolean(b.commissioned)) - Number(Boolean(a.commissioned));
    }

    if (a.commissioned && b.commissioned) {
      return getFirstPerformanceDate(b.id) - getFirstPerformanceDate(a.id);
    }

    return collator.compare(a.kana || a.title, b.kana || b.title);
  });
---

<BaseLayout
  title="演奏曲一覧 | A-Winds奈良アマチュアウィンドオーケストラ Official Web Site"
  description="A-Windsがこれまでに演奏した曲の一覧です。"
  ogType="article"
>
  <div class="title">
    <h1 class="headline">演奏曲一覧</h1>
    <h2 class="headline-en">Past Performances</h2>
  </div>

  <section class="Section">
    <div class="search-container">
      <input type="search" id="search" placeholder="曲名または作/編曲者で検索..." autocomplete="off" />
      <button id="clear-search" type="button">クリア</button>
    </div>

    <div class="controls">
      <button id="open-all" type="button">すべて展開</button>
      <button id="close-all" type="button">すべて閉じる</button>
    </div>

    <div id="piece-list">
      {sortedPieces.map((piece) => (
        <PastPerformanceItem piece={piece} performances={performancesByPiece.get(piece.id) ?? []} />
      ))}
    </div>
  </section>

  <script is:inline src={`${import.meta.env.BASE_URL}js/pastPerformances.js`}></script>
</BaseLayout>
