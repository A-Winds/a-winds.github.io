---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AWindsLogo from "../../components/AWindsLogo.astro";
---

<BaseLayout title="活動日程 | A-Winds奈良アマチュアウィンドオーケストラ Official Web Site" description="A-Windsの活動日程です。" ogType="article">

  <div class="title">
    <h1 class="headline">活動日程</h1>
    <h2 class="headline-en">Calendar</h2>
  </div>

  <section class="Section">
      <p class="calendar-description">
        <AWindsLogo />の活動日程です。<br />
        カレンダーが表示されない場合は、<a class="url-calendar" href="https://calendar.google.com/calendar/embed?src=325af3633895e36bf30bc615eefbb7e3520b9a44019ac5efdf3c59e6305aa14e%40group.calendar.google.com&ctz=Asia%2FTokyo" target="_blank">こちら</a>からご確認ください。
      </p>
      <div class="calendar">
          <iframe src="https://calendar.google.com/calendar/embed?height=600&wkst=1&ctz=Asia%2FTokyo&bgcolor=%23ffffff&showTitle=0&showPrint=0&showTabs=0&showCalendars=0&showTz=0&src=MzI1YWYzNjMzODk1ZTM2YmYzMGJjNjE1ZWVmYmI3ZTM1MjBiOWE0NDAxOWFjNWVmZGYzYzU5ZTYzMDVhYTE0ZUBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23D81B60" style="border-width:0" width="800" height="600" frameborder="0" scrolling="no"></iframe>
      </div>
  </section>

</BaseLayout>
