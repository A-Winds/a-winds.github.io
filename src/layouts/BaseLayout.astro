---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/headerfooter.css";
import "../styles/index.css";

const {
  title = "A-Winds奈良アマチュアウィンドオーケストラ Official Web Site",
  description =
    "奈良県の吹奏楽団、A-Windsのウェブサイトです。楽団の紹介や演奏会情報を掲載しています。",
  ogType = "website",
} = Astro.props;

const path = (value = "") =>
  `${import.meta.env.BASE_URL}${value.replace(/^\/+/, "")}`;

const pageUrl = new URL(Astro.url.pathname, Astro.site);

const ogImageUrl = new URL(path("img/ogimage.jpg"), Astro.site);

---

<!doctype html>
<html lang="ja" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;700&display=swap" rel="stylesheet" />

    <script is:inline>
    (() => {
        const savedTheme = localStorage.getItem("theme");

        const systemTheme = window.matchMedia(
        "(prefers-color-scheme: dark)"
        ).matches
        ? "dark"
        : "light";

        document.documentElement.dataset.theme =
        savedTheme ?? systemTheme;
    })();
    </script>

    <link rel="apple-touch-icon" sizes="180x180" href={path("img/favicon/apple-touch-icon.png")} />
    <link rel="icon" href={path("img/favicon/favicon.ico")} />
    <link rel="manifest" href={path("img/favicon/site.webmanifest")} />
    <link rel="mask-icon" href={path("img/favicon/safari-pinned-tab.svg")} color="#5bbad5" />
    <meta name="msapplication-TileColor" content="#ffffff" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="A-Winds Official Web Site" />
    <meta property="og:image" content={ogImageUrl.href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="max-image-preview:large" />
  </head>

  <body>
    <Header />

    <slot />

    <Footer />

    <script is:inline src={path("js/scrollEffect.js")}></script>
    <script is:inline src={path("js/headerEffect.js")}></script>
  </body>
</html>
